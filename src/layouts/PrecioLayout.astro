---
import GoogleAnalytics from '../components/GoogleAnalytics.astro'
import FranjaPreciosObra from '../components/FranjaPreciosObra.astro'

// Layout de las páginas de precios, análisis y guías (SEO). Desde el
// 21-nov-2026 usa el mismo modo oscuro futurista de la portada: fondo negro con
// rejilla y auroras, tipografía Manrope/JetBrains Mono, header de vidrio oscuro
// con el logo esfera. Renderiza el <head> completo con SEO + JSON-LD opcional.
const {
  title,
  description,
  canonicalPath = '/',
  jsonld = null,
  // [{ nombre, path }] — la misma ruta que se ve arriba de la página. Google la
  // muestra en el resultado en lugar de la URL cruda, que se lee mejor y ayuda
  // al clic. Las migas ya existían visualmente pero sin marcado, así que Google
  // no las entendía como estructura.
  breadcrumbs = null,
  // Páginas que existen y se navegan, pero que no aportan nada que Google no
  // tenga ya en otra URL. Van `noindex, follow`: no compiten por rastreo, pero
  // siguen pasando sus enlaces.
  noindex = false,
  // Sin la franja «Qué más puedes hacer en Precios Obra» (Fase 4), p. ej. en el
  // índice de precios, que ya es la portada de todo eso.
  sinFranja = false,
  // Imagen al compartir (WhatsApp, Facebook…), 1200×630. Cada guía trae la suya.
  ogImage: ogPath = '/assets/og-precios-v2.jpg',
} = Astro.props

const site = 'https://controlobra.ai'
const canonical = new URL(canonicalPath, site).href

// Marca «Precios Obra» en el título de todas las páginas (plan Google, Fase 5).
const tituloFinal = /precios\s?obra/i.test(title) ? title : `${title} | Precios Obra`

// Quién publica el sitio (Fase 5): Google lo usa para el nombre del sitio y el
// logo en el resultado. Va en todas las páginas, junto a lo que mande cada una.
const marcaLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site}/#organizacion`,
    name: 'Precios Obra',
    alternateName: 'PreciosObra',
    url: `${site}/`,
    logo: `${site}/assets/logo-icon-hd.png`,
    description: 'Precios de construcción de República Dominicana por zona, análisis de precios unitarios y calculadora de obra, gratis.',
    areaServed: { '@type': 'Country', name: 'República Dominicana' },
    parentOrganization: { '@type': 'Organization', name: 'ControlObra', url: `${site}/` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site}/#sitio`,
    name: 'Precios Obra',
    alternateName: ['PreciosObra', 'ControlObra'],
    url: `${site}/`,
    inLanguage: 'es-DO',
    publisher: { '@id': `${site}/#organizacion` },
  },
]

const migasLd = breadcrumbs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.nombre,
        item: new URL(b.path, site).href,
      })),
    }
  : null

// Se fusiona con lo que mande la página (Product, FAQPage, WebPage…).
const bloques = [
  ...(Array.isArray(jsonld) ? jsonld : jsonld ? [jsonld] : []),
  ...(migasLd ? [migasLd] : []),
  ...marcaLd,
]
const jsonldFinal = bloques.length ? (bloques.length === 1 ? bloques[0] : bloques) : null
const ogImage = new URL(ogPath, site).href
const APP = 'https://app.controlobra.ai'
// Botón "compartir por WhatsApp": abre WhatsApp con el mensaje + link ya listos.
const shareText = `${title}\n👉 ${canonical}\n\nPrecios reales de construcción en RD, gratis. Compartilo con quien esté construyendo 👷`
const waShare = 'https://wa.me/?text=' + encodeURIComponent(shareText)
---
<!doctype html>
<html lang="es" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tituloFinal}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="es-do" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  <meta name="theme-color" content="#06080C" />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_DO" />
  <meta property="og:site_name" content="Precios Obra" />
  <meta property="og:title" content={tituloFinal} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:secure_url" content={ogImage} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:alt" content={tituloFinal} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={tituloFinal} />
  <meta name="twitter:description" content={description} />

  <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-48.png" />
  <link rel="icon" type="image/png" href="/assets/favicon-controlobra.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-controlobra.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  {jsonldFinal && <script type="application/ld+json" set:html={JSON.stringify(jsonldFinal)} />}

  <GoogleAnalytics />
  <!-- Red de partículas que se une al cursor, igual que en la portada. -->
  <script is:inline src="/assets/fx-net.js" defer></script>
  <!-- Botón flotante de WhatsApp (el mismo de la portada; el mensaje dice qué página está viendo). -->
  <script is:inline src="/assets/wa-widget.js" defer></script>
</head>
<body>
  <header class="topbar">
    <div class="wrap bar">
      <a class="brand" href="/precios/">
        <img src="/assets/logo-icon.png" alt="" width="38" height="38" />
        <span class="brand-tx">Precios Obra<small>REPÚBLICA DOMINICANA</small></span>
      </a>
      <nav class="nav">
        <a href="/precios/">Catálogo</a>
        <a href="/analisis/">Análisis</a>
        <a href="/guias/">Guías</a>
        <a href={`${APP}/precios-obra/calculadora`}>Calculadora</a>
        <a class="nav-cta" href={`${APP}/precios-obra`}>Abrir la app ↗</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <slot />
    {!sinFranja && <FranjaPreciosObra />}
    <div class="wa-share">
      <a href={waShare} target="_blank" rel="noopener" aria-label="Compartir por WhatsApp">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.15-1.7-.85-2-.95-.26-.1-.45-.15-.64.15-.19.28-.73.94-.9 1.13-.16.19-.33.2-.62.07-.29-.15-1.22-.45-2.33-1.44-.86-.77-1.44-1.71-1.61-2-.17-.29-.02-.45.13-.6.13-.13.29-.34.44-.5.15-.17.19-.29.29-.48.1-.19.05-.36-.02-.5-.08-.15-.64-1.55-.88-2.12-.23-.55-.47-.48-.64-.48-.16-.01-.36-.01-.55-.01-.19 0-.5.07-.77.36-.26.29-1 .98-1 2.38s1.03 2.76 1.17 2.95c.14.19 2.01 3.08 4.88 4.32.68.29 1.21.47 1.63.6.68.22 1.31.19 1.8.11.55-.08 1.7-.69 1.94-1.36.24-.67.24-1.24.17-1.36-.07-.12-.26-.19-.55-.34zM12 2a10 10 0 0 0-8.6 15.06L2 22l5.06-1.33A10 10 0 1 0 12 2z"/></svg>
        Compartir por WhatsApp
      </a>
    </div>
  </main>

  <footer class="foot">
    <div class="wrap">
      <p><strong>Precios Obra</strong> · Datos abiertos de construcción de República Dominicana · un producto de ControlObra.</p>
      <p class="tiny">Precios referenciales aportados por la comunidad técnica del país, no cotizaciones formales. <a href="/metodologia/">Cómo calculamos los precios</a>.</p>
    </div>
  </footer>

  <script is:inline>
    // Cada enlace a la app dice de qué página salió (plan Google → app,
    // nov-2026). La app guarda la llegada y el panel Actividad de Precios Obra
    // cuenta, por página de origen, cuántos entran, se registran y vuelven.
    (function () {
      try {
        var desde = location.pathname
        document.querySelectorAll('a[href^="https://app.controlobra.ai"]').forEach(function (a) {
          var u = new URL(a.href)
          if (u.searchParams.has('utm_source')) return
          u.searchParams.set('utm_source', 'controlobra')
          u.searchParams.set('utm_medium', 'web')
          u.searchParams.set('utm_content', desde)
          a.href = u.toString()
        })
      } catch (e) {}
    })()
  </script>
</body>
</html>

<style is:global>
  /* ═══ MODO OSCURO FUTURISTA (21-nov-2026) ═══════════════════════════════
     Mismo lenguaje que la portada (src/pages/index.html): fondo casi negro,
     rejilla técnica, auroras naranjas y paneles de "vidrio oscuro". Estas
     páginas van SIEMPRE en oscuro (antes seguían el tema del sistema).
     Naranja de marca #F26B1F intacto; para texto naranja sobre negro se usa
     #FFA265 (--orange-2 de la portada). */
  :root {
    color-scheme: dark;
    --bg: #06080C;
    --paper: rgba(20,25,34,.72);
    --paper-2: rgba(255,255,255,.035);
    --ink: #E8EAEE;
    --ink-2: #B9C0CA;
    --muted: #8E96A2;
    --line: rgba(255,255,255,.08);
    --line-2: rgba(255,255,255,.13);
    --brand: #F26B1F;
    --brand-deep: #FFA265;
    --brand-dark: #C5501A;
    --brand-soft: rgba(242,107,31,.16);
    --brand-wash: rgba(242,107,31,.07);
    --z-norte: #7FA2EA;
    --z-sur: #EC8F8F;
    --z-este: #5CC297;
    --fresh: #5CC297;
    --fresh-soft: rgba(31,138,91,.18);
    /* colores por tipo de recurso (los de la app, aclarados para fondo negro) */
    --t-material: #FFA265;   --t-material-bg: rgba(242,107,31,.16);
    --t-mo: #B79AF5;         --t-mo-bg: rgba(122,77,191,.2);
    --t-equipos: #56B6CE;    --t-equipos-bg: rgba(14,116,144,.22);
    --t-transporte: #E0A65C; --t-transporte-bg: rgba(180,83,9,.2);
    --t-todo: #5CC297;       --t-todo-bg: rgba(31,138,91,.18);
    --grid: rgba(255,255,255,.028);
    --grid-edge: rgba(255,255,255,.05);
    --shadow: inset 0 1px 0 rgba(255,255,255,.05), 0 24px 48px -28px rgba(0,0,0,.75);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0;
    color: var(--ink);
    font-family: 'Manrope', system-ui, sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    background: var(--bg);
  }
  /* Fondo fijo: rejilla técnica + auroras (igual que la portada). */
  body::before {
    content: ''; position: fixed; inset: 0; z-index: -2; pointer-events: none;
    background:
      linear-gradient(rgba(255,255,255,.028) 1px, transparent 1px) 0 0 / 64px 64px,
      linear-gradient(90deg, rgba(255,255,255,.028) 1px, transparent 1px) 0 0 / 64px 64px,
      linear-gradient(180deg, #06080C, #0A0D13 50%, #06080C);
    -webkit-mask-image: radial-gradient(ellipse 120% 90% at 50% 40%, #000 35%, rgba(0,0,0,.35) 100%);
            mask-image: radial-gradient(ellipse 120% 90% at 50% 40%, #000 35%, rgba(0,0,0,.35) 100%);
  }
  body::after {
    content: ''; position: fixed; inset: -20%; z-index: -1; pointer-events: none;
    background:
      radial-gradient(circle at 18% 22%, rgba(242,107,31,.12), transparent 32%),
      radial-gradient(circle at 84% 70%, rgba(242,107,31,.08), transparent 30%),
      radial-gradient(circle at 70% 12%, rgba(73,112,201,.08), transparent 28%);
  }
  /* En PC las auroras se mueven lento; en el celular quedan quietas (batería). */
  @media (min-width: 861px) and (prefers-reduced-motion: no-preference) {
    body::after { animation: fxAurora 38s ease-in-out infinite alternate; }
  }
  @keyframes fxAurora {
    0% { transform: translate3d(0,0,0) rotate(0deg); }
    50% { transform: translate3d(4%,-3%,0) rotate(6deg); }
    100% { transform: translate3d(-3%,4%,0) rotate(-4deg); }
  }
  ::selection { background: rgba(242,107,31,.35); color: #fff; }

  h1, h2, h3 { font-family: 'Manrope', system-ui, sans-serif; color: #fff; letter-spacing: -.02em; }
  main.wrap h1 { text-shadow: 0 0 32px rgba(255,255,255,.10); }
  .wrap { width: 100%; max-width: 1160px; margin: 0 auto; padding: 0 22px; }
  .tnum { font-variant-numeric: tabular-nums; }
  .mono { font-family: 'JetBrains Mono', monospace; }
  a { color: inherit; }

  .topbar {
    position: sticky; top: 0; z-index: 30;
    background: rgba(6,8,12,.72);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
            backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid rgba(255,255,255,.07);
    box-shadow: 0 10px 30px -18px rgba(0,0,0,.7);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 66px; }
  .brand { display: flex; align-items: center; gap: 11px; text-decoration: none; }
  .brand img { display: block; }
  .brand-tx { font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 18px; letter-spacing: -.02em; line-height: 1; color: #fff; display: flex; flex-direction: column; gap: 3px; }
  .brand-tx small { font-family: 'JetBrains Mono', monospace; font-weight: 400; font-size: 8.5px; letter-spacing: .14em; color: var(--muted); }
  .nav { display: flex; align-items: center; gap: 22px; font-size: 14.5px; font-weight: 600; color: var(--ink-2); font-family: 'Manrope', sans-serif; }
  .nav a { text-decoration: none; }
  .nav a { transition: color .15s ease; }
  .nav a:hover { color: #fff; }
  .nav-cta {
    color: #fff; background: var(--brand); padding: 9px 16px; border-radius: 999px;
    font-weight: 700; white-space: nowrap; transition: filter .15s ease, box-shadow .15s ease;
    box-shadow: 0 0 0 1px rgba(255,162,101,.35), 0 8px 28px -6px rgba(242,107,31,.6);
  }
  .nav-cta:hover { color: #fff; filter: brightness(1.08); box-shadow: 0 0 0 1px rgba(255,162,101,.5), 0 10px 32px -6px rgba(242,107,31,.75); }
  @media (max-width: 660px) { .nav a:not(.nav-cta) { display: none; } .brand-tx small { display: none; } }

  .wa-share { margin-top: 40px; display: flex; justify-content: center; }
  .wa-share a {
    display: inline-flex; align-items: center; gap: 10px; text-decoration: none;
    background: #25D366; color: #fff; font-weight: 700; font-size: 15px;
    padding: 12px 22px; border-radius: 999px; box-shadow: 0 8px 20px -10px rgba(37,211,102,.7);
    transition: background .15s ease, transform .15s ease;
  }
  .wa-share a:hover { background: #1EBE5D; transform: translateY(-2px); color: #fff; }

  .foot { margin-top: 40px; border-top: 1px solid var(--line); padding: 30px 0 52px; color: var(--muted); position: relative; }
  .foot::before {
    content: ''; position: absolute; left: 50%; top: -1px; width: min(900px, 80%); height: 1px; transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, rgba(242,107,31,.45), transparent);
  }
  .foot strong { color: var(--ink); }

  /* ── Diseño compacto (pedido de Carlos, 21-nov-2026) ──────────────────────
     Textos ajustados y sin espacio perdido: que en una pantalla, en PC y en el
     celular, se vea lo más posible. Va aquí, en un solo lugar, para todas las
     páginas: el prefijo `main.wrap` le gana a los estilos propios de cada
     página sin tener que tocarlas una por una. Al diseñar una página nueva,
     seguir esta misma densidad (WEB.md §8). */
  body { line-height: 1.5; }
  .bar { height: 54px; }
  .brand img { width: 32px; height: 32px; }
  main.wrap .crumb { padding-top: 12px; font-size: 12px; }
  main.wrap .eyebrow { margin-top: 10px; }
  main.wrap h1 { font-size: clamp(24px, 4.4vw, 34px); line-height: 1.12; margin-top: 6px; }
  main.wrap .lead { font-size: 15px; line-height: 1.5; margin-top: 8px; }
  main.wrap .badge { margin-top: 10px; }
  main.wrap .hero { margin-top: 14px; padding: 16px 18px; gap: 16px; }
  main.wrap section { margin-top: 26px; }
  main.wrap h2 { font-size: 18px; }
  main.wrap .sub { font-size: 13px; margin-bottom: 10px; }
  main.wrap p { margin-bottom: 10px; }
  /* Los textos usan todo el ancho (Carlos, 21-nov): sin columnas angostas. */
  main.wrap h1, main.wrap .lead, main.wrap p, main.wrap .hnote { max-width: none; }
  main.wrap .disc { margin-top: 14px; }
  .wa-share { margin-top: 22px; }
  .foot { margin-top: 22px; padding: 16px 0 26px; }
  @media (max-width: 660px) {
    .wrap { padding: 0 14px; }
    main.wrap h1 { font-size: 23px; }
    main.wrap .lead { font-size: 14.5px; }
    main.wrap section { margin-top: 22px; }
  }

  /* ═══ NARANJA CON MEDIDA (pedido de Carlos, 22-nov-2026) ═══════════════════
     Mismo criterio que la portada: el naranja #F26B1F queda solo en botones de
     acción, cifras clave (precios) y una palabra destacada por título.
     Etiquetas, bordes, enlaces de texto y fondos pasan a gris/blanco suave; el
     naranja vuelve al pasar el mouse. Va aquí, con el prefijo `main.wrap`, para
     ganarle a los estilos propios de cada página sin tocarlas una por una. */
  :root { --tone-line: rgba(255,255,255,.10); --tone-soft: rgba(255,255,255,.05); --tone-txt: #C9CED6; }
  body::after { opacity: .35; }
  .foot::before { background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,.05) 15%, rgba(255,255,255,.22) 50%, rgba(255,255,255,.05) 85%, transparent 100%); }
  footer.foot a { color: var(--tone-txt); text-decoration: underline; text-decoration-color: rgba(255,255,255,.25); text-underline-offset: 3px; }
  footer.foot a:hover { color: var(--brand-deep); }
  /* Etiquetas e insignias: vidrio gris */
  main.wrap :is(.eyebrow, .gb-eyebrow) { color: #9AA3B2; }
  main.wrap :is(.pill, .tag) { color: var(--tone-txt); background: var(--tone-soft); box-shadow: inset 0 0 0 1px var(--tone-line); }
  /* Respuesta directa y filas destacadas: borde y fondo neutros */
  main.wrap .directa { border-left-color: rgba(255,255,255,.35); }
  main.wrap tbody tr.destacada { background: rgba(255,255,255,.04); }
  main.wrap tbody tr:hover { background: rgba(255,255,255,.035); }
  /* Bloques con fondo naranja suave → vidrio oscuro */
  main.wrap .guia-banner { background: var(--paper); }
  main.wrap .bloque-app { background: var(--tone-soft); border-color: var(--tone-line); }
  /* Enlaces de texto y "Leer →": claros; naranja al pasar el mouse */
  main.wrap :is(.go, .gb-go, .ver-todos, .todas a, .falta a, .empty a, .cta-link, .mc-cta) { color: #E8EAEE; border-bottom-color: rgba(255,255,255,.3); }
  main.wrap :is(.ver-todos, .todas a, .falta a, .empty a, .cta-link, .mc-cta):hover,
  main.wrap :is(.card, .guia-banner):hover :is(.go, .gb-go) { color: var(--brand-deep); }
  main.wrap p a:not([class]), main.wrap li a:not([class]) { color: #E8EAEE; text-decoration-color: rgba(255,255,255,.3); }
  main.wrap p a:not([class]):hover, main.wrap li a:not([class]):hover { color: var(--brand-deep); text-decoration-color: currentColor; }
  /* Chips y tarjetas: borde neutro; naranja tenue solo al pasar el mouse */
  main.wrap :is(.chip, .card, .cat, .guia-banner, a.esp-card):hover { border-color: rgba(242,107,31,.35); }
  .foot p { margin: 0 0 5px; font-size: 13px; }
  .foot .tiny { font-size: 12px; }
  .foot a { color: var(--brand-deep); text-decoration: none; }
  .foot a:hover { text-decoration: underline; }
</style>
