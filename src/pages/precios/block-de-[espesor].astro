---
import PrecioLayout from '../../layouts/PrecioLayout.astro'
import TablaPrecios from '../../components/TablaPrecios.astro'
import CtaCalculadora from '../../components/CtaCalculadora.astro'
import CalculadoraInline from '../../components/CalculadoraInline.astro'
import { MATERIALES, getBlockPorEspesor, isoHoy, categoriaDeMaterial, TIPO_RESUMEN } from '../../lib/precios.js'
import NotaMoneda from '../../components/NotaMoneda.astro'

// Página propia por espesor de block: /precios/block-de-4/, -6/, -8/.
//
// El 13-sep-2026 se confirmó que "precio del block de 6 en RD" (1.958
// impresiones/45 días, posición ~9.5) no le gana ni a ferreterías
// individuales (Ferretería Gigante, Sumer) ni aparece controlobra.ai en el
// top 10 — a pesar de que /precios/block/ ya tiene una SECCIÓN "por espesor"
// desde el 19-ago. Una sección no es lo mismo que una URL propia con su
// propio título exacto: acá los que ganan son fichas sueltas de una sola
// ferretería, no gigantes de autoridad como en "precio del block" a secas
// (MercadoLibre, SIDIP.gob.do) — batalla mucho más ganable.
export async function getStaticPaths() {
  return ['4', '6', '8'].map((espesor) => ({ params: { espesor } }))
}

const { espesor } = Astro.params
const data = await getBlockPorEspesor(espesor)
if (!data) return Astro.redirect('/precios/block/')

const fmt = (v) =>
  Number.isFinite(v) ? v.toLocaleString('es-DO', { maximumFractionDigits: 0 }) : '—'

// Mismo marcado que las 13 páginas de material (ver [material].astro):
// Product+AggregateOffer con priceCurrency DOP explícito, para que si Google
// arma su insignia de precio en el resultado, sea con la moneda correcta —
// sin este dato estructurado, arma la insignia igual leyendo el número del
// texto y asume USD (ver bug-google-precios-como-usd.md).
const productLd = data.tipico
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: `${data.nombre} (precio en República Dominicana)`,
      description: data.seoDesc,
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'DOP',
        lowPrice: Math.round(data.minPrecio),
        highPrice: Math.round(data.maxPrecio),
        offerCount: data.nProductos,
        areaServed: 'República Dominicana',
      },
    }
  : null
const faqLd = data.faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: data.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null
const paginaLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: `https://controlobra.ai/precios/${data.slug}/`,
  name: data.seoTitle,
  description: data.seoDesc,
  dateModified: isoHoy(),
  inLanguage: 'es-DO',
  isPartOf: { '@type': 'WebSite', name: 'PreciosObra', url: 'https://controlobra.ai/' },
}

const jsonldArr = [productLd, faqLd, paginaLd].filter(Boolean)
const jsonld = jsonldArr.length === 1 ? jsonldArr[0] : (jsonldArr.length ? jsonldArr : null)

// Guía relacionada — mismo criterio que [material].astro.
const GUIAS_DEL_MATERIAL = [
  { href: '/guias/cuanto-cuesta-una-pared-de-block/', titulo: '¿Cuánto cuesta una pared de block?', emoji: '🧱' },
]

// Enlaces cruzados: primero a las OTRAS dos páginas de espesor y a la
// general de block (mismo material, distinta intención), después al resto
// del catálogo — igual que hace [material].astro con "otros materiales".
const otrosEspesores = ['4', '6', '8']
  .filter((e) => e !== espesor)
  .map((e) => ({ slug: `block-de-${e}`, nombre: `Block de ${e}"`, emoji: '🧱' }))
const otros = [
  { slug: 'block', nombre: 'Block (todos los espesores)', emoji: '🧱' },
  ...otrosEspesores,
  ...MATERIALES.filter((m) => m.slug !== 'block').slice(0, 4),
]

const categoria = await categoriaDeMaterial('block')
const CATALOGO = [
  { href: '/precios/resumen/materiales/', titulo: 'Lista completa de precios 2026', emoji: '📋' },
  ...(categoria ? [{ href: `/precios/categoria/${categoria.slug}/`, titulo: `Todos los precios de ${categoria.nombre.toLowerCase()}`, emoji: '🗂️', extra: `${categoria.nProductos} productos` }] : []),
  { href: '/precios/resumen/mano-de-obra/', titulo: `Precios de ${TIPO_RESUMEN.MANO_OBRA.nombre}`, emoji: TIPO_RESUMEN.MANO_OBRA.emoji },
  { href: '/precios/resumen/subcontratos/', titulo: `Precios de ${TIPO_RESUMEN.TODO_COSTO.nombre}`, emoji: TIPO_RESUMEN.TODO_COSTO.emoji },
]
---
<PrecioLayout
  title={data.seoTitle}
  description={data.seoDesc}
  canonicalPath={`/precios/${data.slug}/`}
  jsonld={jsonld}
  breadcrumbs={[
    { nombre: 'Inicio', path: '/' },
    { nombre: 'Precios', path: '/precios/' },
    { nombre: 'Block', path: '/precios/block/' },
    { nombre: data.nombre, path: `/precios/${data.slug}/` },
  ]}
>
  <nav class="crumb">
    <a href="/">Inicio</a> <span>›</span> <a href="/precios/">Precios</a> <span>›</span> <a href="/precios/block/">Block</a> <span>›</span> {data.nombre}
  </nav>

  <p class="eyebrow">Precios de construcción · República Dominicana</p>
  <h1>{data.h1}</h1>
  <p class="lead">{data.intro}</p>

  <NotaMoneda />
  {data.nProductos > 0 ? (
    <>
      <div class="badge">
        <span class="dot"></span> Actualizado {data.actualizado} · {data.nProductos} productos con precio
      </div>

      <div class="hero">
        <div>
          <div class="hlabel">Precio típico · {data.unidad}</div>
          <div class="big tnum">RD$ {fmt(data.tipico)}</div>
          <div class="hnote">Rango RD$ {fmt(data.minPrecio)} – {fmt(data.maxPrecio)} · {data.nProductos} productos reportados</div>
        </div>
        <div class="zonas">
          {data.zonaStats.map((z) => (
            <div class="zona" style={`--zc:${z.color}`}>
              <div class="zl">{z.label}</div>
              <div class="zp tnum">{z.prom ? `RD$ ${fmt(z.prom)}` : '—'}</div>
            </div>
          ))}
        </div>
      </div>

      {data.respuesta && (
        <section class="directa">
          <h2>{data.preguntaClave}</h2>
          <p set:html={data.respuesta} />
        </section>
      )}

      {data.rendimiento && Number.isFinite(data.tipico) && (
        <CalculadoraInline
          rendimiento={data.rendimiento}
          precio={data.tipico}
          unidad={data.unidad}
          nombre={data.nombre}
        />
      )}

      <section>
        <h2>Precios por producto y zona</h2>
        <p class="sub">Cada precio es el más reciente reportado por la comunidad para ese producto en cada zona.</p>
        <TablaPrecios productos={data.productos} />
      </section>
    </>
  ) : (
    <div class="empty">
      <p>Todavía no hay precios de {data.nombre.toLowerCase()} reportados en el catálogo.
      ¿Conocés el precio? <a href="https://app.controlobra.ai/precios-obra/sugerir">Aportalo acá</a> y ayudás a toda la comunidad.</p>
    </div>
  )}

  <section>
    <h2>¿Por qué varía el precio?</h2>
    <p>{data.porque}</p>
    <p>Para una obra completa, un solo material no define el costo total. Antes de comprar conviene estimar el presupuesto completo —materiales, mano de obra e indirectos— con precios de tu zona.</p>
  </section>

  {data.faq && data.faq.length > 0 && (
    <section>
      <h2>Preguntas frecuentes</h2>
      <div class="faq">
        {data.faq.map((f) => (
          <div class="fq">
            <h3>{f.q}</h3>
            <p set:html={f.a} />
          </div>
        ))}
      </div>
    </section>
  )}

  <CtaCalculadora />

  {GUIAS_DEL_MATERIAL.length > 0 && (
    <section>
      <h2>Seguí con la guía</h2>
      <div class="chips">
        {GUIAS_DEL_MATERIAL.map((g) => (
          <a class="chip" href={g.href}>{g.emoji} {g.titulo}</a>
        ))}
      </div>
    </section>
  )}

  <section>
    <h2>Ver el catálogo completo</h2>
    <p class="sub">Todos los precios de construcción en RD, por categoría y por tipo de recurso.</p>
    <div class="cat-grid">
      {CATALOGO.map((c) => (
        <a class="cat" href={c.href}>
          <span class="ce">{c.emoji}</span>
          <span class="ct">{c.titulo}</span>
          {c.extra && <span class="cx">{c.extra}</span>}
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2>Otros precios de block y construcción en RD</h2>
    <div class="chips">
      {otros.map((m) => (
        <a class="chip" href={`/precios/${m.slug}/`}>{m.emoji} {m.nombre}</a>
      ))}
    </div>
  </section>

  <p class="disc">Datos aportados por la comunidad de Precios Obra. Referenciales, no cotizaciones formales. Los precios pueden variar por proveedor, volumen y fecha de compra.</p>
</PrecioLayout>

<style>
  /* Salidas al catálogo: las páginas que mejor convierten del sitio. */
  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 11px; }
  .cat { display: flex; align-items: center; gap: 11px; border: 1px solid var(--line); border-radius: 13px; padding: 14px 16px; background: var(--paper); text-decoration: none; color: var(--ink); transition: border-color .15s, box-shadow .15s; }
  .cat:hover { border-color: var(--brand); box-shadow: var(--shadow); }
  .cat .ce { font-size: 19px; line-height: 1; }
  .cat .ct { font-weight: 650; font-size: 14.5px; line-height: 1.25; }
  .cat .cx { margin-left: auto; font-size: 11.5px; color: var(--muted); white-space: nowrap; font-family: 'DM Mono', monospace; }

  .crumb { font-size: 12.5px; color: var(--muted); padding-top: 26px; display: flex; gap: 7px; flex-wrap: wrap; }
  .crumb a { text-decoration: none; }
  .crumb a:hover { color: var(--brand-deep); }
  .crumb span { color: var(--line-2); }

  .eyebrow { margin-top: 22px; font-size: 11.5px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; color: var(--brand-deep); }
  h1 { font-family: 'Archivo', sans-serif; font-weight: 800; font-size: clamp(30px, 6vw, 44px); line-height: 1.08; letter-spacing: -.01em; margin: 10px 0 0; text-wrap: balance; }
  .lead { font-size: 17px; color: var(--ink-2); margin: 16px 0 0; text-align: justify; text-align-last: left; hyphens: auto; }

  .badge { display: inline-flex; align-items: center; gap: 7px; margin-top: 18px; background: var(--fresh-soft); color: var(--fresh); font-size: 12.5px; font-weight: 600; padding: 6px 12px; border-radius: 999px; }
  .badge .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--fresh); }

  .hero { margin-top: 24px; background: var(--paper); border: 1px solid var(--line); border-radius: 18px; padding: 26px 28px; box-shadow: var(--shadow); display: flex; align-items: flex-end; justify-content: space-between; gap: 26px; flex-wrap: wrap; }
  .hlabel { font-size: 12.5px; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
  .big { font-size: clamp(38px, 8vw, 56px); font-weight: 800; letter-spacing: -.03em; line-height: 1; margin-top: 8px; }
  .hnote { font-size: 13px; color: var(--ink-2); margin-top: 8px; }
  .zonas { display: flex; gap: 10px; }
  .zona { border: 1px solid var(--line); border-left: 3px solid var(--zc); border-radius: 10px; padding: 10px 14px; min-width: 92px; }
  .zl { font-size: 12px; color: var(--muted); font-weight: 600; }
  .zp { font-size: 15px; font-weight: 700; font-family: 'DM Mono', monospace; margin-top: 3px; }

  section { margin-top: 44px; }
  h2 { font-size: 21px; letter-spacing: -.02em; margin: 0 0 4px; font-weight: 700; }
  .sub { color: var(--muted); font-size: 14px; margin: 0 0 16px; }
  p { margin: 0 0 14px; text-align: justify; text-align-last: left; hyphens: auto; }

  .empty { margin-top: 24px; padding: 24px; border: 1px dashed var(--line-2); border-radius: 14px; color: var(--ink-2); }
  .empty a { color: var(--brand-deep); font-weight: 600; }

  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--line-2); border-radius: 999px; padding: 9px 16px; font-size: 14px; font-weight: 500; text-decoration: none; color: var(--ink); background: var(--paper); transition: border-color .15s, color .15s; }
  .chip:hover { border-color: var(--brand); color: var(--brand-deep); }

  .faq { display: flex; flex-direction: column; gap: 16px; }
  .fq h3 { font-size: 16px; font-weight: 700; margin: 0 0 4px; letter-spacing: -.01em; }
  .fq p { margin: 0; color: var(--ink-2); text-align: justify; text-align-last: left; hyphens: auto; }
  strong { font-weight: 700; }

  .directa { border-left: 3px solid var(--brand); padding-left: 18px; }
  .directa p { font-size: 16px; line-height: 1.6; margin: 0; }

  .disc { font-size: 12px; color: var(--muted); font-style: italic; margin-top: 26px; }
</style>
